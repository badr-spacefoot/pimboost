generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatcherType {
  exact
  regex
  contains
}

enum RuleStatus {
  draft
  validated
  rejected
}

enum MappingRuleType {
  one_to_one
  contextual
  regex
  sql_case
}

model MappingProject {
  id            String        @id @default(cuid())
  name          String
  sourceName    String        @map("source_name")
  attributeName String        @map("attribute_name")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  rules         MappingRule[]

  @@map("mapping_projects")
}

model MappingRule {
  id              String           @id @default(cuid())
  projectId       String?          @map("project_id")
  sourceName      String?          @map("source_name")
  attributeName   String?          @map("attribute_name")
  sourceValue     String           @map("source_value")
  targetValue     String           @map("target_value")
  matcherType     MatcherType      @map("matcher_type")
  ruleType        MappingRuleType  @default(regex) @map("rule_type")
  priority        Int              @default(100)
  confidenceScore Float            @default(0) @map("confidence_score")
  status          RuleStatus       @default(draft)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  project         MappingProject?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history         MappingHistory[]
  conditions      MappingRuleCondition[]

  @@index([projectId])
  @@index([sourceName, attributeName, ruleType])
  @@map("mapping_rules")
}

model MappingRuleCondition {
  id             String      @id @default(cuid())
  ruleId         String      @map("rule_id")
  sourcePath     String      @map("source_path")
  operator       String
  value          String
  conditionGroup String      @default("default") @map("condition_group")
  createdAt      DateTime    @default(now()) @map("created_at")
  rule           MappingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("mapping_rule_conditions")
}

model MappingHistory {
  id             String      @id @default(cuid())
  ruleId         String      @map("rule_id")
  oldTargetValue String?     @map("old_target_value")
  newTargetValue String      @map("new_target_value")
  changedBy      String?     @map("changed_by")
  changedAt      DateTime    @default(now()) @map("changed_at")
  rule           MappingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("mapping_history")
}

model SuggestionMemory {
  id                    String   @id @default(cuid())
  attributeName         String   @map("attribute_name")
  sourceValueNormalized String   @map("source_value_normalized")
  targetValue           String   @map("target_value")
  usageCount            Int      @default(1) @map("usage_count")
  lastUsedAt            DateTime @default(now()) @map("last_used_at")

  @@unique([attributeName, sourceValueNormalized])
  @@map("suggestion_memory")
}

model MappingKnowledgeBase {
  id                    String     @id @default(cuid())
  sourceName            String     @default("*") @map("source_name")
  attributeName         String     @map("attribute_name")
  sourceValue           String     @map("source_value")
  sourceValueNormalized String     @map("source_value_normalized")
  targetValue           String     @map("target_value")
  sourcePath            String?    @map("source_path")
  matcherType           MatcherType @default(exact) @map("matcher_type")
  ruleType              MappingRuleType @default(one_to_one) @map("rule_type")
  conditions            Json?
  family                String?
  sport                 String?
  category              String?
  brand                 String?
  gender                String?
  confidenceScore       Float      @default(1) @map("confidence_score")
  status                RuleStatus @default(validated)
  validationCount       Int        @default(1) @map("validation_count")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@unique([sourceName, attributeName, sourceValueNormalized], name: "source_attribute_source_value_unique")
  @@index([attributeName, sourceValueNormalized])
  @@index([attributeName, targetValue])
  @@map("mapping_knowledge_base")
}

model TargetValue {
  id            String   @id @default(cuid())
  attributeName String   @map("attribute_name")
  targetValue   String   @map("target_value")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([attributeName, targetValue])
  @@map("target_values")
}

model TrainingExample {
  id                    String              @id @default(cuid())
  sourceName            String?             @map("source_name")
  attributeName         String              @map("attribute_name")
  sourcePath            String?             @map("source_path")
  sourceValue           String              @map("source_value")
  sourceValueNormalized String              @map("source_value_normalized")
  targetValue           String              @map("target_value")
  family                String?
  sport                 String?
  category              String?
  brand                 String?
  gender                String?
  matcherType           MatcherType         @default(exact) @map("matcher_type")
  confidenceScore       Float               @default(1) @map("confidence_score")
  status                RuleStatus          @default(validated)
  validationCount       Int                 @default(1) @map("validation_count")
  rejectionCount        Int                 @default(0) @map("rejection_count")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  embeddings            TrainingEmbedding[]

  @@index([sourceName, attributeName, sourceValueNormalized])
  @@index([attributeName, targetValue])
  @@map("training_examples")
}

model TrainingEmbedding {
  id                String          @id @default(cuid())
  trainingExampleId String          @map("training_example_id")
  embedding         Unsupported("vector")?
  textRepresentation String         @map("text_representation")
  createdAt         DateTime        @default(now()) @map("created_at")
  trainingExample   TrainingExample @relation(fields: [trainingExampleId], references: [id], onDelete: Cascade)

  @@index([trainingExampleId])
  @@map("training_embeddings")
}
